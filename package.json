    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "react": "^18",
    "react-dom": "^18",
    "react-easy-crop": "^6.2.3",
    "resend": "^6.18.0",
    "sharp": "^0.35.3",
