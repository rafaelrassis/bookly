# Postgres — em produção aponte para Vercel Postgres, Railway, RDS, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/bookly?schema=public"

# conexão direta (sem pgbouncer/pooler), usada só pelo Prisma Migrate.
# em provedores sem pooler (ex: local, RDS) pode repetir o valor acima;
# no Neon é a connection string do host sem "-pooler".
DIRECT_URL="postgresql://user:password@localhost:5432/bookly?schema=public"

# gerar com: npx auth secret
AUTH_SECRET=""

# URL pública usada pelo Auth.js pra montar as callback URLs OAuth
# (https://<dominio>/api/auth/callback/<provider>). Em dev, http://localhost:3000.
AUTH_URL="http://localhost:3000"

# login/criação de conta via Google — https://console.cloud.google.com/apis/credentials
# callback: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# login/criação de conta via Amazon (Login with Amazon) — https://developer.amazon.com/loginwithamazon/console/site/lwa/overview.html
# callback: <AUTH_URL>/api/auth/callback/amazon
AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""

# reativa o login/cadastro por e-mail e senha (Credentials + bcrypt), desligado
# por padrão desde a migração pra OAuth. O código continua no repo — "true"
# religa /signup, /forgot-password, troca de senha e o formulário em /login.
NEXT_PUBLIC_EMAIL_LOGIN_ENABLED="false"

# dev: e-mails de verificação de troca de e-mail vão pro console (sem SENDGRID_API_KEY).
# prod: configurar SENDGRID_API_KEY + MAIL_FROM.
# SENDGRID_API_KEY=""
# MAIL_FROM=""

# busca/detalhe de livro (fora do catálogo semeado) via Google Books API.
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=""

# envio do formulário "Ajude a melhorar o Bookly" (POST /api/feedback) via Resend.
# https://resend.com
RESEND_API_KEY=""
FEEDBACK_TO_EMAIL=""

# URL pública de produção (sem barra final) — base do metadata/OG/manifest.
# Domínio atual do deploy: https://bookly-puce.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# rate limiting (sliding window) nas rotas de escrita via Upstash Redis.
# https://upstash.com — copiar as credenciais REST do database.
# sem essas duas vars o rate limit fica fail-open (libera tudo, só loga).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
