// Prisma schema — auth (Spec 0/1), perfil (Spec 2), catálogo/estante/reviews
// (Spec 3a), clubes/chat (Spec 4) e feed social/listas (Spec 3b).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  /// Nula até o onboarding (login OAuth não coleta username — só e-mail/nome).
  username      String?      @unique @db.Citext
  name          String
  /// Só existe pra contas criadas via /signup com o login por e-mail/senha
  /// (feature flag EMAIL_LOGIN_ENABLED); nula pra contas OAuth.
  passwordHash  String?
  emailVerified DateTime?
  bio           String?      @db.VarChar(500)
  /// Índice do gradiente de avatar escolhido (AVATAR_CHOICES no front); usado
  /// como fallback quando avatarUrl não está definido.
  avatar        Int          @default(0)
  /// Foto de perfil enviada pelo usuário (Vercel Blob, WebP 400x400); nula
  /// até o primeiro upload, quando o gradiente (avatar) é usado.
  avatarUrl     String?
  genres        String[]     @default([])
  /// Até 4 bookIds em destaque no perfil (catálogo mocado até a Spec 3).
  top4          String[]     @default([])
  progressUnit  ProgressUnit @default(pages)
  /// Localização do usuário (opcional); usada como default no filtro de
  /// doações e para pré-preencher o formulário de criar doação.
  city          String?
  state         String?      @db.Char(2)
  /// Falso até o usuário concluir o onboarding (username + gêneros) no
  /// primeiro login OAuth — controla o gate de acesso ao grupo (app).
  onboarded     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts Account[]
  sessions Session[]

  followedBy Follow[] @relation("following")
  following  Follow[] @relation("follower")

  shelfEntries ShelfEntry[]
  reviews      Review[]
  bookTags     BookTag[]
  quotes       Quote[]
  readingGoals ReadingGoal[]

  createdClubs Club[]       @relation("clubCreator")
  clubMembers  ClubMember[]
  messages     Message[]

  reviewLikes ReviewLike[]
  comments    Comment[]
  lists       List[]

  donations        Donation[]        @relation("DonorDonations")
  donationRequests DonationRequest[] @relation("SentRequests")

  notifications      Notification[] @relation("UserNotifications")
  actedNotifications Notification[] @relation("ActorNotifications")
}

/// Conta OAuth vinculada a um User (Google/Amazon) — Auth.js PrismaAdapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Exigida pelo tipo do PrismaAdapter; não usada em runtime — a sessão da
/// aplicação é JWT (ver src/lib/auth.ts) pro middleware rodar no Edge.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Exigida pelo tipo do PrismaAdapter; não usada em runtime (sem provider
/// de e-mail/magic link).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Follow {
  id            String   @id @default(cuid())
  followerId    String
  follower      User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId   String
  followingUser User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model VerificationCode {
  id        String           @id @default(cuid())
  email     String
  code      String
  type      VerificationType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([email, type])
}

enum ShelfStatus {
  WANT_TO_READ
  READING
  READ
  DNF
}

enum Visibility {
  public
  private
}

enum ProgressUnit {
  pages
  percent
}

enum VerificationType {
  email
  /// Só usado pelo fluxo de reset de senha (feature flag EMAIL_LOGIN_ENABLED).
  password
}

/// Catálogo semeado (Spec 0 previa Google Books; adiado como enriquecimento
/// futuro — ver docs/specs). `avg`/`count` são cache, recalculados por
/// recomputeBookRating() a cada gravação/remoção de Review.
model Book {
  id           String   @id
  title        String
  authors      String
  year         Int
  pages        Int
  genre        String
  gradientFrom String
  gradientTo   String
  synopsis     String
  /// Capa real (Google Books); nula pro catálogo semeado, que usa o gradiente.
  coverUrl     String?
  /// ISBN-13 (ou ISBN-10 se não houver 13) da edição resolvida — permite
  /// deduplicar por livro já importado sem gastar cota do Google Books
  /// (import de CSV do Goodreads).
  isbn         String?  @unique
  avg          Float    @default(0)
  count        Int      @default(0)
  createdAt    DateTime @default(now())
  /// Toca só nos campos voláteis (título/autores/sinopse/capa) refrescados
  /// do Google Books; usada pela política de staleness em getOrCreateBook().
  updatedAt    DateTime @updatedAt

  shelfEntries ShelfEntry[]
  reviews      Review[]
  tags         BookTag[]
  quotes       Quote[]
  clubs        Club[]
  listBooks    ListBook[]
  donations    Donation[]

  @@index([genre])
}

/// Estante do usuário: status + progresso. currentPage/lastPage sempre em
/// páginas (a unidade de exibição é User.progressUnit).
model ShelfEntry {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status      ShelfStatus
  currentPage Int?
  lastPage    Int?
  startedAt   DateTime?
  finishedAt  DateTime?
  /// Quando o status virou DNF; null enquanto ativo ou se nunca foi abandonado.
  abandonedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, bookId])
  @@index([bookId])
}

/// Meta anual de livros (Reading Challenge). Progresso é derivado de
/// ShelfEntry (status READ + finishedAt no ano), não persistido aqui.
model ReadingGoal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  targetBooks Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year])
}

/// Rating e review são a mesma entidade (1 por usuário+livro). Nota <= 0
/// apaga a linha inteira (espelha o "remover nota" do protótipo). `title`
/// é opcional — sem ele, a review some no feed como um post de texto puro.
model Review {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  rating     Float
  title      String?   @db.VarChar(150)
  text       String    @default("")
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  likes    ReviewLike[]
  comments Comment[]

  @@unique([userId, bookId])
  @@index([bookId, createdAt])
}

/// Curtida em review (Spec 3b) — 1 por usuário+review.
model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

/// Comentário em review (Spec 3b) — thread flat, sem resposta a comentário.
model Comment {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([reviewId, createdAt])
}

/// Lista de livros do usuário (Spec 3b).
model List {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String     @db.VarChar(80)
  visibility Visibility @default(public)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  books ListBook[]
}

model ListBook {
  id        String   @id @default(cuid())
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order     Int
  createdAt DateTime @default(now())

  @@unique([listId, bookId])
  @@index([listId, order])
}

model BookTag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    String

  @@unique([userId, bookId, tag])
  @@index([userId, tag])
}

model Quote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  text      String
  page      Int?
  createdAt DateTime @default(now())

  @@index([userId, bookId])
}

/// Clube do livro (Spec 4). `code` (6 chars, só privados) é único e
/// visível apenas ao criador.
model Club {
  id         String     @id @default(cuid())
  name       String     @db.VarChar(80)
  desc       String     @default("") @db.VarChar(500)
  visibility Visibility
  code       String?    @unique
  bookId     String
  book       Book       @relation(fields: [bookId], references: [id])
  creatorId  String
  creator    User       @relation("clubCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  members  ClubMember[]
  messages Message[]
}

/// Vínculo de membro; `progress` guarda o último percentual publicado no
/// mural (para detectar mudança e emitir a mensagem de sistema uma só vez).
model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "creator" | "member"
  role     String   @default("member")
  progress Int?
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
  @@index([userId])
}

/// Mural em formato de chat. `system` marca mensagens automáticas de
/// progresso; `replyTo` é a citação de outra mensagem do mesmo clube.
model Message {
  id        String    @id @default(cuid())
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String    @db.VarChar(500)
  system    Boolean   @default(false)
  replyToId String?
  replyTo   Message?  @relation("messageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("messageReplies")
  createdAt DateTime  @default(now())

  @@index([clubId, createdAt])
}

enum DonationStatus {
  DISPONIVEL
  RESERVADO
  DOADO
}

enum RequestStatus {
  PENDENTE
  ESCOLHIDO
  RECUSADO
}

/// Doação de livro físico entre usuários (feed social). O contato do doador
/// só é exposto (ver serializeDonation) pro próprio doador ou pro interessado
/// ESCOLHIDO — nunca pra fila inteira.
model Donation {
  id        String         @id @default(cuid())
  bookId    String
  book      Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  donorId   String
  donor     User           @relation("DonorDonations", fields: [donorId], references: [id], onDelete: Cascade)
  photoUrl  String
  city      String
  state     String         @db.Char(2) // UF
  /// Geocodificadas a partir de city/state na criação (Nominatim); nulas se
  /// o geocoding falhar — a doação continua normal, só some da busca por
  /// raio (ver src/lib/geocode.ts e GET /api/books/[id]/donations).
  latitude  Float?
  longitude Float?
  status    DonationStatus @default(DISPONIVEL)
  whatsapp  String?
  instagram String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  donatedAt DateTime?
  /// Quando a doação entrou em RESERVADO — usado pra expirar a reserva
  /// automaticamente (ver src/lib/donation-expiry.ts).
  reservedAt DateTime?
  /// Quando o aviso de "reserva expira em breve" foi enviado — evita
  /// reenviar o aviso todo dia até a expiração de fato.
  reserveWarnedAt DateTime?
  /// Quando o interessado ESCOLHIDO confirmou ter recebido o livro —
  /// independente de o doador já ter marcado como DOADO (ver
  /// POST /api/donations/[id]/confirm-receipt).
  receiverConfirmedAt DateTime?

  requests      DonationRequest[]
  notifications Notification[]

  @@index([bookId, status])
  @@index([state, city, status])
  @@index([donorId, status])
}

/// Interesse ("Quero este") de um usuário em uma Donation. ESCOLHIDO libera
/// o contato do doador pro requester (ver serializeDonation).
model DonationRequest {
  id          String        @id @default(cuid())
  donationId  String
  donation    Donation      @relation(fields: [donationId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User          @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  status      RequestStatus @default(PENDENTE)
  createdAt   DateTime      @default(now())

  @@unique([donationId, requesterId])
  @@index([donationId, status])
  @@index([requesterId])
}

enum NotificationType {
  DONATION_REQUEST_RECEIVED // doador: alguém pediu seu livro
  DONATION_CHOSEN // recebedor: você foi escolhido
  DONATION_COMPLETED // recebedor: doador confirmou a doação
  DONATION_RESERVE_EXPIRING // doador/recebedor: reserva expira em breve (cron)
  DONATION_RESERVE_EXPIRED // doador/recebedor: reserva expirou, livro liberado (cron)
  DONATION_RECEIPT_CONFIRMED // doador: recebedor confirmou o recebimento
  DONATION_RESERVE_EXTENDED // recebedor: doador estendeu o prazo
}

/// Notificação in-app genérica (sino + contador) — cobre o fluxo de doação
/// (pedido/escolha/conclusão, com actor; e expiração de reserva, disparada
/// pelo cron sem actor) e serve pra follows/reviews/clubes depois sem
/// precisar de nova tabela.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  actorId    String?
  actor      User?            @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  donationId String?
  donation   Donation?        @relation(fields: [donationId], references: [id], onDelete: Cascade)
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read, createdAt])
}
